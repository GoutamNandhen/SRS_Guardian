  "cards": [
    {
      "dot": "cyan",
      "title": "Document Ingestion & Extraction",
      "items": [
        "Multi-format ingestion parses PDF, DOCX, and TXT files via PyMuPDF and python-docx",
        "Layered extraction cascades from explicit IDs (REQ-xxx) to structural cues and modal verbs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic & ML Analysis Engines",
      "items": [
        "Classification: TF-IDF + Logistic Regression with SHAP token attribution",
        "Ambiguity: 6 rule checks (weak terms, vague pronouns, passive voice) + Flesch/Fog readability",
        "Semantic Duplicates: all-MiniLM-L6-v2 cosine similarity with content lemma blocking",
        "Contradictions: Numeric interval algebra + zero-cost DeBERTa MNLI on-demand",
        "Standards: EARS 6-template syntactic matching + 7 ISO/IEC/IEEE 29148 checks"
      ]
    },
    {
      "dot": "amber",
      "title": "Quality Scoring & Human Review",
      "items": [
        "Quality Scoring: 0-100 deterministic score with a step-by-step penalty waterfall trace",
        "Human-in-the-Loop: Reviewer accepts, rejects, or edits AI findings before final report export"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Performance",
      "items": [
        "100% Offline CPU Inference: Zero third-party LLM leakage for sensitive requirement documents",
        "Model Disk Cache: SHA-256 caching for sentence embeddings and NLI pairs prevents recomputation",
        "Audit Trail: Immutable review history and versioning stored in SQLite / PostgreSQL"
      ]
    }
  ]
}
